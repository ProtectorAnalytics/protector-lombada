{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadro Lombada",
  "version": "1.2.0",
  "identifier": "br.com.appps.lombada.quadro",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://lombada.appps.com.br",
      "capabilities": ["quadro-remoto"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NTU1OTVEOTJDNzFFRjYKUldUMkhzZVNYVmxWS0d5RzVVdTJPd3RXeVJCVmZVcG1PTVZDNDBFZURDdzZ6MDRwQk9ZVFdYaDEK",
      "endpoints": [
        "https://github.com/ProtectorAnalytics/protector-lombada/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "Protector Sistemas de Segurança",
    "shortDescription": "Quadro da portaria",
    "longDescription": "Janela pequena, sempre por cima, com a última passagem na Lombada Educativa.",
    "category": "Utility",
    "copyright": "Protector Sistemas de Segurança",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
